<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="20dp"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/academic_suite"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="220dp"
            android:layout_height="200dp"
            android:background="@drawable/bg_card_cream"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:background="@drawable/bg_card_dark_green"
                android:padding="6dp"
                android:src="@drawable/ic_check"
                android:contentDescription="@string/desc_checkmark" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_graduation_cap"
                    android:contentDescription="@string/desc_graduation_cap" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/est_2026"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_cream"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/tagline_pill"
            android:textColor="@color/green_forest_dark"
            android:textSize="12sp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/attendease_heading"
            android:fontFamily="serif"
            android:textColor="@color/text_primary"
            android:textSize="36sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_description"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="18dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_cream"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="@string/badge_fast"
                android:textColor="@color/pill_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_cream"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="@string/badge_accurate"
                android:textColor="@color/pill_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_cream"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="@string/badge_organized"
                android:textColor="@color/pill_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/etLoginEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="@string/email_hint"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="16dp"
            android:drawableStart="@drawable/ic_email"
            android:drawablePadding="12dp"
            android:layout_marginBottom="12dp"
            android:inputType="textEmailAddress"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etLoginPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="@string/password_hint"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="16dp"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="12dp"
            android:layout_marginBottom="20dp"
            android:inputType="textPassword"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/get_started"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@null"
            android:background="@drawable/bg_button_primary"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvGoToRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sign_in_register"
            android:textColor="@color/green_forest_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="8dp" />

    </LinearLayout>
</ScrollView>